    {
      "dot": "cyan",
      "title": "Four ways in",
      "items": [
        "Paste a comma-separated lat/long list",
        "Upload a dissolved GeoJSON polygon",
        "Draw a shape on the map, or paste geohashes"
      ]
    },
    {
      "dot": "emerald",
      "title": "Conversion core",
      "items": [
        "polygeohasher turns polygons into geohash cells",
        "GeoPandas reprojects to EPSG:3857 to buffer non-polygons",
        "Map preview is capped; exports contain every cell"
      ]
    },
    {
      "dot": "violet",
      "title": "Rerun model",
      "items": [
        "Streamlit reruns the whole page on every widget change",
        "Drawn shapes survive only because session_state holds them",
        "Drawing uses newdraw.py, a custom Folium Draw control"
      ]
    }
  ]
